{
  "name": "setup-tracker",
  "version": "0.4.0",
  "description": "Local press setup sheet tracker for Viking Forge",
  "main": "app/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "ocr-smoke": "xvfb-run -a electron --no-sandbox scripts/ocr-smoke.js || electron scripts/ocr-smoke.js",
    "screenshots": "xvfb-run -a electron --no-sandbox scripts/screenshots.js || electron scripts/screenshots.js",
    "dist": "electron-builder --win --publish never",
    "icon": "node scripts/make-icon.js",
    "templates": "node scripts/make-templates.js"
  },
  "author": "AxialForge",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "build": {
    "appId": "com.axialforge.setuptracker",
    "productName": "Setup Tracker",
    "copyright": "AxialForge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders,cmaps,standard_fonts,iccs}/**",
      "!node_modules/pdfjs-dist/build/{*.map,pdf.mjs,pdf.worker.mjs,pdf.sandbox*}",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/tesseract.js-core/{tesseract-core,tesseract-core-simd,tesseract-core-relaxedsimd}.{js,wasm}",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Setup-Tracker-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Setup Tracker",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AxialForge",
        "repo": "SheetTracker"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/{bmp-js,idb-keyval,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,opencollective-postinstall,regenerator-runtime,wasm-feature-detect,zlibjs}/**"
    ]
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  }
}
